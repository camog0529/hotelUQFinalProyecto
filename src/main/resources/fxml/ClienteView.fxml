<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="hoteluq.controller.ClienteController"
            stylesheets="@../css/Styles.css" styleClass="main-container">
    <left>
        <VBox styleClass="sidebar" spacing="12">
            <padding><Insets top="28" right="18" bottom="24" left="18"/></padding>
            <Label text="HotelUQ" styleClass="sidebar-title"/>
            <Label text="PERFIL DE CLIENTE" styleClass="sidebar-subtitle"/>
            <Button fx:id="btnNavReservas" text="Mis reservas" styleClass="sidebar-button"/>
            <Button text="Mi cuenta" styleClass="sidebar-button, active"/>
            <Button fx:id="btnCerrarSesion" text="Cerrar sesión" styleClass="sidebar-button"/>
        </VBox>
    </left>
    <center>
        <VBox spacing="18">
            <padding><Insets top="25" right="25" bottom="25" left="25"/></padding>
            <VBox spacing="5">
                <Label text="Mi cuenta" styleClass="content-title"/>
                <Label text="Información privada del cliente autenticado." styleClass="content-subtitle"/>
            </VBox>
            <GridPane hgap="20" vgap="18" styleClass="form-container">
                <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                <Label text="Nombre" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <Label fx:id="lblNombre" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label text="Cédula" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Label fx:id="lblCedula" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                <Label text="Saldo de tarjeta" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <Label fx:id="lblSaldo" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                <Label text="Puntos vigentes" styleClass="form-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <Label fx:id="lblPuntos" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            </GridPane>
            <Label text="Movimientos de mi tarjeta" styleClass="section-title"/>
            <ListView fx:id="listMovimientos" VBox.vgrow="ALWAYS"/>
        </VBox>
    </center>
</BorderPane>

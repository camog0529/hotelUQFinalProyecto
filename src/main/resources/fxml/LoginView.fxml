<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="hoteluq.controller.LoginController" alignment="CENTER" spacing="14"
      stylesheets="@../css/Styles.css" styleClass="auth-container">
    <padding><Insets top="34" right="42" bottom="34" left="42"/></padding>
    <Label text="HotelUQ" styleClass="auth-title"/>
    <Label text="Sistema integral de gestión hotelera" styleClass="content-subtitle"/>
    <Label text="Iniciar sesión" styleClass="section-title"/>
    <TextField fx:id="txtUsuario" promptText="Cédula o usuario administrador" maxWidth="360"/>
    <PasswordField fx:id="txtContrasena" promptText="Contraseña" maxWidth="360" onAction="#handleIniciarSesion"/>
    <Button text="Ingresar" onAction="#handleIniciarSesion" styleClass="btn-primary" maxWidth="360"/>
    <Button text="Crear cuenta de cliente" onAction="#handleAbrirRegistro" styleClass="btn-secondary" maxWidth="360"/>
    <Label text="Demo administrador: admin / HotelUQ2026!" styleClass="content-subtitle" wrapText="true"/>
    <Label text="Demo clientes: 1111 o 2222 / Cliente2026!" styleClass="content-subtitle" wrapText="true"/>
</VBox>
